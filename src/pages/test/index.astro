---
import '@/styles/test.css';
import Base from '@/layouts/Base.astro';
import Embleme from '@/components/test/Embleme.astro';
import donnees from '@/data/test-appareils.json';
import { lienJournaliste } from '@/lib/contenu';
import { capitale, lienAppareil, ordreDeDepartage } from '@/lib/test-appareils';
import { typo } from '@/lib/typo.mjs';

const { questions, resultats } = donnees;
const LETTRES = ['a', 'b', 'c', 'd'];
---

<Base titre="Quel appareil êtes-vous ?" description="Le test de L’Humianité. Dix questions, huit profils : découvrez enfin quel appareil vous êtes.">
  <div class="page test">
    <header class="test__tete">
      <p class="test__rubrique">Le test</p>
      <h1>Quel appareil êtes-vous&#8239;?</h1>
      <p class="test__chapo">
        {typo('Branché, débranché, rechargé, mis à jour : vous l’êtes tous les jours. Mais au fond, quel appareil êtes-vous ? Dix questions pour le savoir. Répondez spontanément, une seule case par question.')}
      </p>
      <p class="test__signature service">
        Test conçu par <a href={lienJournaliste('kevin-prompt')}>Kevin Prompt</a>. Barème établi par <a href={lienJournaliste('mina-contresens')}>Mina Contresens</a>.
      </p>
    </header>

    <form class="questionnaire" data-test data-ordre={JSON.stringify(ordreDeDepartage(resultats))} novalidate>
      <ol class="questionnaire__liste">
        {
          questions.map((question, q) => (
            <li>
              <fieldset class="question" data-question={q + 1} id={`question-${q + 1}`}>
                <legend class="question__intitule">
                  <span class="question__numero">{q + 1}</span>
                  {typo(question.intitule)}
                </legend>
                <ul class="question__reponses">
                  {question.reponses.map((reponse, r) => (
                    <li>
                      <label class="reponse">
                        <input type="radio" name={question.id} value={LETTRES[r]} data-points={JSON.stringify(reponse.points)} />
                        <span class="reponse__case" aria-hidden="true">{LETTRES[r]}</span>
                        <span class="reponse__texte">{typo(reponse.texte)}</span>
                      </label>
                    </li>
                  ))}
                </ul>
              </fieldset>
            </li>
          ))
        }
      </ol>

      <div class="questionnaire__envoi" data-zone="envoi" hidden>
        <p class="questionnaire__compte service" data-zone="compte" aria-live="polite"></p>
        <button type="submit" class="questionnaire__bouton">Découvrir mon appareil</button>
        <p class="questionnaire__note" data-zone="note" role="alert"></p>
      </div>
    </form>

    <section class="profils" aria-labelledby="profils-titre">
      <div class="tetiere">
        <h2 id="profils-titre">Les huit profils</h2>
        <span class="service">Un seul vous correspond</span>
      </div>
      <ol class="profils__liste">
        {
          resultats.map((r) => (
            <li>
              <a class="profil" href={lienAppareil(r.id)}>
                <Embleme appareil={r.id} class="profil__embleme" />
                <span class="profil__nom">{capitale(typo(r.nom))}</span>
                <span class="profil__accroche">{typo(r.accroche)}</span>
              </a>
            </li>
          ))
        }
      </ol>
    </section>

    <footer class="test__notes">
      <section>
        <h2>Méthode</h2>
        <p>
          {typo('Chaque réponse attribue des points à un ou plusieurs appareils. L’appareil qui en totalise le plus vous est attribué. En cas d’égalité, le barème retient l’appareil en service depuis le plus longtemps.')}
        </p>
      </section>
      <section>
        <h2>Confidentialité</h2>
        <p>{typo('Vos réponses ne quittent pas votre appareil. Elles ne sont ni transmises, ni conservées, ni relues.')}</p>
      </section>
      <section>
        <h2>Réserve</h2>
        <p>{typo('Les profils proposés ne constituent pas un diagnostic. En cas de doute sur votre nature, consultez un professionnel qualifié.')}</p>
      </section>
    </footer>
  </div>
</Base>

<script>
  import { passerLeTest } from '@/modules/test/test.ts';

  passerLeTest();
</script>
