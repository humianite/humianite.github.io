---
import '@/styles/test.css';
import Base from '@/layouts/Base.astro';
import donnees from '@/data/test-appareils.json';
import { lienJournaliste } from '@/lib/contenu';
import { ordreDeDepartage } from '@/lib/test-appareils';
import { typo } from '@/lib/typo.mjs';

const { questions, resultats, coefficients } = donnees;
const LETTRES = ['a', 'b', 'c', 'd'];
---

<Base titre="Quel appareil êtes-vous ?" description="Le test de L’Humianité. Douze questions pour savoir enfin quel appareil vous êtes.">
  <div class="page test">
    <header class="test__tete">
      <p class="test__rubrique">Le test</p>
      <h1>Quel appareil êtes-vous&#8239;?</h1>
      <p class="test__chapo">
        {typo('Branché, débranché, rechargé, mis à jour : vous l’êtes tous les jours. Mais au fond, quel appareil êtes-vous ? Douze questions pour le savoir. Répondez spontanément.')}
      </p>
      <p class="test__signature service">
        Test conçu par <a href={lienJournaliste('kevin-prompt')}>Kevin Prompt</a>. Barème établi par <a href={lienJournaliste('mina-contresens')}>Mina Contresens</a>.
      </p>
    </header>

    <form class="questionnaire" data-test data-ordre={JSON.stringify(ordreDeDepartage(resultats))} data-coefficients={JSON.stringify(coefficients)} novalidate>
      <div class="questionnaire__pilotage" data-zone="pilotage" hidden>
        <p class="questionnaire__avancement service" data-zone="avancement" aria-live="polite"></p>
        <button type="button" class="questionnaire__retour" data-zone="retour" hidden>← Question précédente</button>
      </div>
      <div class="questionnaire__jauge" data-zone="jauge" aria-hidden="true"></div>

      <ol class="questionnaire__liste">
        {
          questions.map((question, q) => (
            <li>
              <fieldset class="question" data-question={q + 1} id={`question-${q + 1}`}>
                <legend class="question__intitule">
                  <span class="question__numero">{q + 1}</span>
                  {typo(question.intitule)}
                </legend>
                <ul class="question__reponses">
                  {question.reponses.map((reponse, r) => (
                    <li>
                      <label class="reponse">
                        <input type="radio" name={question.id} value={LETTRES[r]} data-points={JSON.stringify(reponse.points)} />
                        <span class="reponse__case" aria-hidden="true">{LETTRES[r]}</span>
                        <span class="reponse__texte">{typo(reponse.texte)}</span>
                      </label>
                    </li>
                  ))}
                </ul>
              </fieldset>
            </li>
          ))
        }
      </ol>

      <div class="calcul" data-zone="calcul" tabindex="-1" role="status" hidden>
        <p class="calcul__titre">Application du barème</p>
        <ol class="calcul__etapes">
          <li data-etape hidden>Dépouillement des douze réponses.</li>
          <li data-etape hidden>Application des coefficients de Mina Contresens.</li>
          <li data-etape hidden>Départage des ex æquo, le cas échéant.</li>
          <li data-etape hidden>Votre appareil a été identifié.</li>
        </ol>
      </div>

      <noscript>
        <p class="questionnaire__note">{typo('Le barème est appliqué par votre navigateur. Activez JavaScript pour connaître votre appareil.')}</p>
      </noscript>
    </form>

    <footer class="test__notes">
      <section>
        <h2>Méthode</h2>
        <p>
          {typo('Chaque réponse attribue des points à un ou plusieurs appareils. Les totaux sont pondérés par un coefficient propre à chaque appareil, établi par Mina Contresens. En cas d’égalité, le barème retient l’appareil en service depuis le plus longtemps.')}
        </p>
      </section>
      <section>
        <h2>Confidentialité</h2>
        <p>{typo('Vos réponses ne quittent pas votre appareil. Elles ne sont ni transmises, ni conservées, ni relues.')}</p>
      </section>
      <section>
        <h2>Réserve</h2>
        <p>{typo('Les profils proposés ne constituent pas un diagnostic. En cas de doute sur votre nature, consultez un professionnel qualifié.')}</p>
      </section>
    </footer>
  </div>
</Base>

<script>
  import { passerLeTest } from '@/modules/test/test.ts';

  passerLeTest();
</script>
