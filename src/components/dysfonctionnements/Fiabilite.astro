---
/** Indicateur de fiabilité éditoriale. Il affiche 100 %, et s'en tient là tant qu'on ne le regarde pas de trop près. */
---

<p class="fiabilite" data-dysfonctionnement="fiabilite" tabindex="0">
  <span class="fiabilite__libelle">Fiabilité éditoriale</span>
  <span class="fiabilite__cadran" aria-hidden="true"><span class="fiabilite__aiguille"></span></span>
  <span class="invisible">100&nbsp;%</span>
  <span class="fiabilite__valeur" aria-hidden="true">100&nbsp;%</span>
  <svg class="fiabilite__coche" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M2.5 8.5 6.5 12.5 13.5 4"></path></svg>
</p>
