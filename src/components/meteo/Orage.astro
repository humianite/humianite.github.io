---
/** Le pictogramme de la pluie et de l'orage : un nuage, quatre traits de pluie, un éclair (masqué quand il ne fait que pleuvoir). */
---

<g class="orage">
  <g class="orage__pluie">
    <line x1="-16" y1="14" x2="-22" y2="30"></line>
    <line x1="-2" y1="14" x2="-8" y2="30"></line>
    <line x1="12" y1="14" x2="6" y2="30"></line>
    <line x1="26" y1="14" x2="20" y2="30"></line>
  </g>
  <path class="orage__eclair" d="M4 6 L-6 26 L2 26 L-4 42 L12 18 L4 18 L10 6 Z"></path>
  <path class="nuage" d="M-30 14 a14 14 0 0 1 2 -27 a20 20 0 0 1 37 -6 a15 15 0 0 1 24 13 a11 11 0 0 1 -3 20 Z"></path>
</g>
