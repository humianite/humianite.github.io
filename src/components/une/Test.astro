---
/** L'appel de la une vers le test : un encadré, les huit emblèmes, un lien. */
import '@/styles/test.css';
import Embleme from '@/components/test/Embleme.astro';
import donnees from '@/data/test-appareils.json';
import { capitale, lienAppareil } from '@/lib/test-appareils';
import { typo } from '@/lib/typo.mjs';
---

<section class="test-appel" aria-labelledby="test-appel-titre">
  <div class="test-appel__texte">
    <p class="surtitre">Le test</p>
    <h2 id="test-appel-titre"><a class="titre-lien" href="/test/">Quel appareil êtes-vous&#8239;?</a></h2>
    <p class="test-appel__chapo">{typo('Dix questions, huit profils. Répondez spontanément, une seule case par question.')}</p>
  </div>
  <ol class="test-appel__emblemes">
    {
      donnees.resultats.map((r) => (
        <li>
          <a href={lienAppareil(r.id)} aria-label={capitale(typo(r.nom))} title={capitale(typo(r.nom))}>
            <Embleme appareil={r.id} />
          </a>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .test-appel {
    display: grid;
    gap: 1.1rem calc(var(--gouttiere) * 2);
    align-items: center;
    padding-block: 1rem 1.1rem;
    border-top: var(--filet);
    border-bottom: var(--filet);
  }

  .test-appel__texte {
    display: grid;
    gap: 0.3rem;
  }

  .test-appel h2 {
    font-family: var(--titre);
    font-weight: 400;
    font-size: clamp(1.7rem, 3.6vw, 2.3rem);
    line-height: 1.02;
    letter-spacing: -0.02em;
  }

  .test-appel__chapo {
    font-style: italic;
    line-height: 1.35;
  }

  .test-appel__emblemes {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 2.6rem));
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .test-appel__emblemes a {
    display: block;
    transition: transform 0.4s cubic-bezier(0.3, 1.5, 0.5, 1);
  }

  .test-appel__emblemes a:hover {
    color: var(--rouge);
    transform: rotate(-8deg) scale(1.1);
  }

  @media (min-width: 40rem) {
    .test-appel {
      grid-template-columns: minmax(0, 1fr) auto;
    }

    .test-appel__emblemes {
      grid-template-columns: repeat(8, 2.4rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .test-appel__emblemes a {
      transition: none;
    }
  }
</style>
