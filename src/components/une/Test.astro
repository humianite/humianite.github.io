---
/** L'appel de la une vers le test : un encadré, un lien. Les résultats ne se découvrent qu'à la fin du test. */
import { typo } from '@/lib/typo.mjs';
---

<section class="test-appel" aria-labelledby="test-appel-titre">
  <div class="test-appel__texte">
    <p class="surtitre">Le test</p>
    <h2 id="test-appel-titre"><a class="titre-lien" href="/test/">Quel appareil êtes-vous&#8239;?</a></h2>
    <p class="test-appel__chapo">{typo('Douze questions. Répondez spontanément.')}</p>
  </div>
  <a class="test-appel__bouton" href="/test/">Commencer le test</a>
</section>

<style>
  .test-appel {
    display: grid;
    gap: 1.1rem calc(var(--gouttiere) * 2);
    align-items: center;
    justify-items: start;
    padding-block: 1rem 1.1rem;
    border-top: var(--filet);
    border-bottom: var(--filet);
  }

  .test-appel__texte {
    display: grid;
    gap: 0.3rem;
  }

  .test-appel h2 {
    font-family: var(--titre);
    font-weight: 400;
    font-size: clamp(1.7rem, 3.6vw, 2.3rem);
    line-height: 1.02;
    letter-spacing: -0.02em;
  }

  .test-appel__chapo {
    font-style: italic;
    line-height: 1.35;
  }

  .test-appel__bouton {
    padding: 0.6rem 1.2rem 0.65rem;
    background: var(--encre);
    color: var(--papier);
    font-family: var(--util);
    font-weight: 800;
    text-decoration: none;
    white-space: nowrap;
  }

  .test-appel__bouton:hover {
    background: var(--rouge);
  }

  @media (min-width: 40rem) {
    .test-appel {
      grid-template-columns: minmax(0, 1fr) auto;
    }
  }
</style>
