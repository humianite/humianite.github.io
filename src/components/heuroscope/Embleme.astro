---
/**
 * Emblème d'un signe de l'Heuroscope. Si le signe a un médaillon gravé (un SVG dont la racine
 * porte l'identifiant « embleme »), il est appelé par référence et prend la couleur du texte ;
 * sinon, son pictogramme est tracé ici, dans un médaillon à double filet.
 */
import type { Signe } from '@/lib/heuroscope';

interface Props {
  signe: Signe;
  class?: string;
}

const { signe, class: classe } = Astro.props;

/** Un tracé par signe, dans un carré de 48 unités. */
const TRACES: Record<string, string> = {
  formulaire: 'M15 9h18v30H15z M19 16h10 M19 21h10 M19 26h5 M19 31h4v4h-4z',
  relance: 'M34 17a12 12 0 1 0 2 11 M34 9v8h-8 M24 22v0',
  preavis: 'M9 15h30v20H9z M9 15l15 12 15-12 M24 31v0',
  annexe: 'M12 13h17v24H12z M19 13V9h17v24h-7 M16 20h9 M16 25h9 M16 30h5',
  'piece-jointe': 'M31 14 18 27a4 4 0 0 0 6 6l13-13a7 7 0 0 0-10-10L13 24a10 10 0 0 0 14 14l10-10',
  'compte-rendu': 'M11 13v0 M16 13h21 M11 21v0 M16 21h21 M11 29v0 M16 29h14 M11 37v0 M16 37h8',
  derogation: 'M7 31h11 M30 31h11 M18 31c0-14 12-14 12 0 M24 12v-4 M17 14l-2-3 M31 14l2-3',
  doute: 'M17 17a7 7 0 1 1 10 6c-2 1-3 3-3 6 M24 36v0',
  tampon: 'M19 9h10l-2 15h-6z M12 24h24v8H12z M10 38h28',
  'mise-en-copie': 'M22 17a8 8 0 1 0 0 14 M36 17a8 8 0 1 0 0 14',
  delai: 'M14 9h20 M14 39h20 M16 9c0 9 16 11 16 30 M32 9c0 9-16 11-16 30 M21 34h6',
  'erreur-humaine': 'M13 13l22 22 M35 13 13 35 M29 41h10',
};
---

<span class:list={['embleme', classe]} aria-hidden="true">
  {
    signe.data.embleme ? (
      <svg class="embleme__gravure" viewBox="0 0 800 800" focusable="false">
        <use href={`${signe.data.embleme}#embleme`} />
      </svg>
    ) : (
      <svg viewBox="0 0 48 48" focusable="false">
        <circle cx="24" cy="24" r="23" />
        <circle cx="24" cy="24" r="20.5" class="embleme__filet" />
        <path d={TRACES[signe.id]} />
      </svg>
    )
  }
</span>
