---
/**
 * Emblème d'un appareil du test : un pictogramme au trait, dans un médaillon à double filet,
 * comme les signes de l'Heuroscope. Il prend la couleur du texte.
 */

interface Props {
  appareil: string;
  class?: string;
}

const { appareil, class: classe } = Astro.props;

/** Un tracé par appareil, dans un carré de 48 unités. */
const TRACES: Record<string, string> = {
  'appareil-photo-argentique': 'M10 17h28v18H10z M18 17l2-4h8l2 4 M32 14h3 M30 26a6 6 0 1 1-12 0a6 6 0 1 1 12 0 M14 21v0',
  'voiture-electrique': 'M8 31v-6l5-1 4-6h13l5 6 5 1v6h-2 M17 31h12 M10 31h-2 M18 31a3 3 0 1 1-6 0a3 3 0 1 1 6 0 M35 31a3 3 0 1 1-6 0a3 3 0 1 1 6 0 M25 19l-2 4h3l-2 4',
  smartphone: 'M18 9h12a2.5 2.5 0 0 1 2.5 2.5v25a2.5 2.5 0 0 1-2.5 2.5H18a2.5 2.5 0 0 1-2.5-2.5v-25A2.5 2.5 0 0 1 18 9z M22 12.5h4 M15.5 33h17 M24 36v0',
  drone: 'M20 21h8v6h-8z M20 21l-5-5 M28 21l5-5 M20 27l-5 5 M28 27l5 5 M10 16h10 M28 16h10 M10 32h10 M28 32h10 M24 27v3',
  'pompe-a-chaleur': 'M9 13h30v21H9z M26 23.5a7 7 0 1 1-14 0a7 7 0 1 1 14 0 M19 17.5v12 M13 23.5h12 M30 18h5 M30 22h5 M30 26h5 M30 30h5 M13 34v3 M35 34v3',
  'data-center': 'M12 10h24v8H12z M12 20h24v8H12z M12 30h24v8H12z M16 14v0 M16 24v0 M16 34v0 M22 14h10 M22 24h10 M22 34h10',
  imprimante: 'M15 9h18v9H15z M9 18h30v13H9z M15 26h18v13H15z M19 31h10 M19 34.5h6 M34 22v0',
  'machine-a-cafe': 'M13 10h22v7H13z M13 17v21 M35 17v21 M11 38h26 M22 17v3h4v-3 M19 27h10v5a3 3 0 0 1-3 3h-4a3 3 0 0 1-3-3z M29 29h1.5a2 2 0 0 1 0 4H29 M30 13.5v0',
};
---

<span class:list={['appareil-embleme', classe]} aria-hidden="true">
  <svg viewBox="0 0 48 48" focusable="false">
    <circle cx="24" cy="24" r="23" />
    <circle cx="24" cy="24" r="20.5" class="appareil-embleme__filet" />
    <path d={TRACES[appareil]} />
  </svg>
</span>
